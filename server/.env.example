# ============================================================
# 心笺 · 服务端环境变量模板
# 复制成 server/.env 用于本地开发；Railway 上在 Variables 里逐条填。
# 千万不要把真实的 .env 提交到 Git。
# ============================================================

# ---------- 必填 ----------
# OpenRouter 密钥（https://openrouter.ai/keys）
OPENROUTER_API_KEY=
# App 访问口令：公网部署必须设置，否则任何人都能刷你的额度
# 生成方法：openssl rand -hex 24   或   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=

# ---------- 模型（可选） ----------
# 默认使用免费模型路由器
AI_MODEL=openrouter/free

# 只允许这些模型（逗号分隔，留空表示按下面 ALLOW_PAID_MODELS 规则判断）
# 例：ALLOWED_MODELS=openrouter/free,baidu/ernie-5.5-flash-preview:free
ALLOWED_MODELS=

# 只开放这些服务商（逗号分隔）
ALLOWED_PROVIDERS=openrouter

# 是否允许收费模型。默认 false —— 免费额度不会被悄悄花掉
ALLOW_PAID_MODELS=false

# ---------- 限流与体积（可选） ----------
AI_MAX_INPUT_CHARS=4000
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=200
# 全站每日总调用上限，防止被刷爆
AI_GLOBAL_DAILY=300
AI_TIMEOUT_MS=25000

# ---------- 其他服务商（可选，配上才会启用） ----------
# 注意：这些都是按量计费的 API，费用由你自己的账户承担
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- 可选 ----------
# OpenRouter 统计用的来源标识
APP_REFERER=https://xinjian.local
# 自建 OpenAI 兼容中转（一般不用填）
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- 数据库（本项目客户端不用，可不填） ----------
# DATABASE_URL=
